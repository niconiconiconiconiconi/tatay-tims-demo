---
import Icon from "./Icon.astro";
import { clientConfig as config } from "../data/client.config";
---

{config.site.previewMode && <div class="preview-banner">{config.site.previewLabel}</div>}
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label={`${config.identity.businessName} home`}>
      <span class="brand-mark" aria-hidden="true">{config.identity.logoLetters}</span>
      <span class="brand-copy"><strong>{config.identity.shortName}</strong><small>{config.identity.tagline}</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#services">Services</a><a href="#areas">Areas</a><a href="#process">How it works</a><a href="#faq">FAQ</a>
    </nav>
    <a class="button button-primary header-call" href="#quote"><Icon name="quote" size={20} /> Ask about service</a>
  </div>
</header>
